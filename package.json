{
  "name": "peerhailer",
  "version": "0.0.1",
  "description": "Peer presence and discovery over a hello protocol, transport-neutral and credential-free.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s243a/peerhailer.git"
  },
  "bin": {
    "hail": "bin/hail.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./directory": {
      "types": "./types/directory.d.ts",
      "default": "./src/directory.js"
    },
    "./hail": {
      "types": "./types/hail.d.ts",
      "default": "./src/hail.js"
    },
    "./server": {
      "types": "./types/server.d.ts",
      "default": "./src/server.js"
    },
    "./plugins": {
      "types": "./types/plugins.d.ts",
      "default": "./src/plugins.js"
    }
  },
  "files": [
    "bin",
    "src",
    "types",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "types": "tsc",
    "prepack": "tsc",
    "test:codex-fabric": "node test/live-codex-fabric.mjs",
    "test:acp-native": "node test/live-acp-native-fabric.mjs",
    "test:codex-appserver": "node test/live-codex-appserver-fabric.mjs",
    "test:codex-steer": "node test/live-codex-steer-fabric.mjs",
    "test:composer": "node test/live-composer.mjs",
    "test:composer-fabric": "node test/live-composer-fabric.mjs",
    "test:tunnel-forward": "node test/live-tunnel-forward.mjs",
    "test:remote-control": "node test/live-remote-control.mjs",
    "test:remote-control-real": "node test/live-remote-control-real.mjs"
  },
  "types": "types/index.d.ts",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
